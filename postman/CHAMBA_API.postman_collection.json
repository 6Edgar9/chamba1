	"item": [
		{
			"name": "1. Autenticación",
			"item": [
				{
					"name": "Registrar Usuario (Exitoso)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Status code is 201', function () {",
									"    pm.response.to.have.status(201);",
									"});",
									"var jsonData = pm.response.json();",
									"if (jsonData.accessToken) {",
									"    pm.environment.set('accessToken', jsonData.accessToken);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"fullName\": \"Nuevo Usuario Demo\",\n  \"email\": \"demo.usuario@chamba.pe\",\n  \"password\": \"Password123!\",\n  \"phone\": \"+51 974 000 111\",\n  \"district\": \"Santa Victoria, Chiclayo\",\n  \"address\": \"Av. Grau 400\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/v1/auth/register",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
